---
import PageLayout from "../layouts/PageLayout.astro";
import {
    DEFAULT_NAMES,
    DEFAULT_LEADER_NAMES,
} from "../constants/default-names.js";
import "../styles/team-generator.css";

const defaultNamesText = DEFAULT_NAMES.join("\n");
const defaultLeaderNamesText = DEFAULT_LEADER_NAMES.join("\n");
---

<PageLayout
    title="Random Team Generator - TeachTools"
    description="Quickly generate balanced teams. Drag and drop to adjust teams. Add team leaders, and reshuffle instantly. Generate balanced student teams by group count or size, optionally include leaders, and randomize. All tools on TeachTools are free to use, no payment or login required."
>
    <h1>Random Team Generator</h1>
    <div class="team-app">
        <div class="panel">
            <h2>Team Setup</h2>

            <div class="clear-container">
                <label for="studentNames">Names</label>
                <button
                    type="button"
                    class="btn-tertiary btn-small hidden"
                    id="clear"
                >
                    Clear
                </button>
            </div>
            <textarea id="studentNames">{defaultNamesText}</textarea>
            <p style="font-size: 0.9rem; color: #666; margin-bottom: 1.5rem;">
                <span id="studentCount">0 team members</span>
            </p>

            <div class="radio-group">
                <div class="radio-option">
                    <input
                        type="radio"
                        id="modeCount"
                        name="teamMode"
                        value="count"
                        checked
                    />
                    <label for="modeCount">Number of groups</label>
                </div>
                <input
                    type="number"
                    id="numGroups"
                    min="1"
                    max="20"
                    value="4"
                    aria-label="Number of groups"
                />
            </div>

            <div class="radio-group">
                <div class="radio-option">
                    <input
                        type="radio"
                        id="modeSize"
                        name="teamMode"
                        value="size"
                    />
                    <label for="modeSize">Team members per group</label>
                </div>
                <input
                    type="number"
                    id="groupSize"
                    min="1"
                    max="20"
                    value="4"
                    disabled
                    aria-label="Team members per group"
                />
            </div>

            <div class="checkbox-container">
                <label for="includeLeaders">
                    <input type="checkbox" id="includeLeaders" />
                    <span>Include team leaders 👑</span>
                </label>
            </div>

            <div
                id="separateLeaderControls"
                class="hidden-control"
                style="margin-bottom: 1.5rem; padding: 1rem; background: white; border-radius: 4px;"
            >
                <label
                    for="useSeparateLeaderList"
                    style="display: flex; align-items: center; cursor: pointer; margin: 0;"
                >
                    <input
                        type="checkbox"
                        id="useSeparateLeaderList"
                        disabled
                        style="margin-right: 0.75rem; cursor: pointer; width: 18px; height: 18px;"
                    />
                    <span>Use separate leader list</span>
                </label>
            </div>

            <div id="leaderNamesContainer" class="hidden-control">
                <label for="leaderNames">Leader Names</label>
                <textarea id="leaderNames" placeholder="Alice
Bob
Charlie..."
                    >{defaultLeaderNamesText}</textarea
                >
                <p
                    style="font-size: 0.9rem; color: #666; margin-bottom: 1.5rem;"
                >
                    <span id="leaderCount">0 leaders</span>
                </p>
            </div>

            <div class="btn-group">
                <button type="button" class="btn-primary" id="generateTeamsBtn">
                    Make Teams
                </button>
            </div>

            <div class="btn-group">
                <button type="button" class="btn-tertiary" id="shuffleBtn">
                    🔀 Shuffle
                </button>
                <button type="button" class="btn-tertiary" id="printBtn">
                    🖨️ Print
                </button>
            </div>
        </div>

        <div id="teamsWrapper" style="display: none;">
            <div class="teams-wrapper">
                <p id="teamsTip" style="display: none;" class="help-text">
                    Tip: Drag and drop between teams
                </p>
                <div id="teamsContainer" class="teams-container">
                    <div class="empty-state">Generate teams to see results</div>
                </div>
            </div>
        </div>
    </div>
    <div class="page-content">
        <section class="content-section" aria-labelledby="how-to-heading">
            <div class="section-header">
                <h2 id="how-to-heading">
                    How do I use the Random Team Generator?
                </h2>
                <p>Follow these steps to build balanced teams in minutes.</p>
            </div>
            <ul class="card-list">
                <li class="info-card">
                    <h3>1. Enter the list of names</h3>
                    <p>
                        Enter your list of names in the Names input. Each name
                        should be on a separate line OR separated by a comma.
                    </p>
                </li>
                <li class="info-card">
                    <h3>2. Select team size</h3>
                    <p>
                        Enter either a number of groups or the number of team
                        members per group. You may only enter one of these
                        values.
                    </p>
                </li>
                <li class="info-card">
                    <h3>3. Optionally add team leaders</h3>
                    <p>
                        If you would like each team to have one leader, select
                        the Include team leaders checkbox.
                    </p>
                </li>
                <li class="info-card">
                    <h3>4. Add multiple team leaders</h3>
                    <p>
                        If you would like to have a separate list of team
                        leaders with any number of leaders per team, select the
                        Use separate leader list checkbox.
                    </p>
                </li>
                <li class="info-card">
                    <h3>4. Drag and drop</h3>
                    <p>
                        Use drag and drop to move members or team leaders
                        between teams.
                    </p>
                </li>
                <li class="info-card">
                    <h3>5. Shuffle as needed</h3>
                    <p>
                        Use the Shuffle button to randomize the teams, evenly
                        distributing members and leaders between the teams.
                    </p>
                </li>
                <li class="info-card">
                    <h3>6. Print as needed</h3>
                    <p>
                        When you are done, you can click the Print button to
                        print your team list or save it as a PDF.
                    </p>
                </li>
            </ul>
        </section>

        <section class="content-section" aria-labelledby="features-heading">
            <div class="section-header">
                <h2 id="features-heading">
                    Why teachers use the Random Team Generator
                </h2>
                <p>
                    This tool provides everything you need to quickly build
                    balanced teams for classroom activities, with no payment or
                    login required.
                </p>
            </div>
            <ul class="card-list">
                <li class="info-card">
                    <h3>No payment or login required</h3>
                    <p>
                        All tools on TeachTools are free to use and do not
                        require a username or password.
                    </p>
                </li>
                <li class="info-card">
                    <h3>Create balanced teams</h3>
                    <p>
                        Use our tool to create fair teams for your next
                        activity. You can have confidence that players are
                        evenly distributed across teams.
                    </p>
                </li>
                <li class="info-card">
                    <h3>Include team leaders</h3>
                    <p>
                        You have the option to designate some team members as
                        team leaders. You can even use a separate list of team
                        leaders and distribute them evenly across teams.
                    </p>
                </li>
                <li class="info-card">
                    <h3>Customize teams</h3>
                    <p>
                        Drag and drop members and leaders between teams. Use the
                        Shuffle button to randomize and rebalance the teams.
                    </p>
                </li>
                <li class="info-card">
                    <h3>Give each team a name</h3>
                    <p>
                        Each team has a default name, or you can add your own
                        team name for additional customization.
                    </p>
                </li>
                <li class="info-card">
                    <h3>Save for later</h3>
                    <p>
                        When you’re done, you can print your team list to
                        distribute or save for later.
                    </p>
                </li>
            </ul>
        </section>

        <section class="content-section" aria-labelledby="when-to-use-heading">
            <div class="section-header">
                <h2 id="when-to-use-heading">
                    When should I use the Random Team Generator?
                </h2>
                <p>
                    The generator is useful for classrooms, activities, games,
                    and group events of all kinds.
                </p>
            </div>
            <ul class="card-list">
                <li class="info-card">
                    <h3>Classroom activities</h3>
                    <p>
                        Use this tool so that students can be divided into
                        balanced teams for classroom activities.
                    </p>
                </li>
                <li class="info-card">
                    <h3>Field trips and outings</h3>
                    <p>
                        Divide the group into equal teams and use the Team
                        Leaders feature to assign chaperones to each team.
                    </p>
                </li>
                <li class="info-card">
                    <h3>Teams for party games</h3>
                    <p>
                        Split your friends into rival groups for party games.
                        Set a custom name for your team to show off!
                    </p>
                </li>
                <li class="info-card">
                    <h3>Community activity groups</h3>
                    <p>
                        Use our tool for organizing community action groups,
                        church activities, youth programs, and more.
                    </p>
                </li>
                <li class="info-card">
                    <h3>Sports teams</h3>
                    <p>
                        Great for setting up teams for sports leagues or smaller
                        pick-up games.
                    </p>
                </li>
                <li class="info-card">
                    <h3>Seating charts</h3>
                    <p>
                        Perfect for dividing groups of attendees into smaller
                        groups for table seatings or activities.
                    </p>
                </li>
            </ul>
        </section>

        <section
            class="content-section faq-section"
            aria-labelledby="faq-heading"
        >
            <div class="section-header">
                <h2 id="faq-heading">Frequently asked questions</h2>
                <p>
                    Answers to the most common questions about using the Random
                    Team Generator.
                </p>
            </div>
            <div class="faq-list">
                <article class="faq-item">
                    <h3>
                        <button
                            class="faq-question"
                            type="button"
                            aria-expanded="false"
                            aria-controls="faq-answer-1"
                            id="faq-button-1"
                        >
                            <span
                                >How much does it cost to use the Random Team
                                Generator?</span
                            >
                            <span class="faq-icon" aria-hidden="true">+</span>
                        </button>
                    </h3>
                    <div
                        class="faq-answer"
                        id="faq-answer-1"
                        role="region"
                        aria-labelledby="faq-button-1"
                    >
                        <p>
                            The Random Team Generator is always free to use. No
                            credit card or payment information is required to
                            use this tool.
                        </p>
                    </div>
                </article>

                <article class="faq-item">
                    <h3>
                        <button
                            class="faq-question"
                            type="button"
                            aria-expanded="false"
                            aria-controls="faq-answer-2"
                            id="faq-button-2"
                        >
                            <span
                                >Do I need to login or create a username and
                                password to use the Random Team Generator?</span
                            >
                            <span class="faq-icon" aria-hidden="true">+</span>
                        </button>
                    </h3>
                    <div
                        class="faq-answer"
                        id="faq-answer-2"
                        role="region"
                        aria-labelledby="faq-button-2"
                    >
                        <p>
                            We do not require a username or password to use the
                            Random Team Generator. No login is required.
                        </p>
                    </div>
                </article>

                <article class="faq-item">
                    <h3>
                        <button
                            class="faq-question"
                            type="button"
                            aria-expanded="false"
                            aria-controls="faq-answer-3"
                            id="faq-button-3"
                        >
                            <span
                                >What is the difference between Number of groups
                                and Team members per group?</span
                            >
                            <span class="faq-icon" aria-hidden="true">+</span>
                        </button>
                    </h3>
                    <div
                        class="faq-answer"
                        id="faq-answer-3"
                        role="region"
                        aria-labelledby="faq-button-3"
                    >
                        <p>
                            Number of groups refers to the total number of
                            groups that will be created from your list when you
                            click the Make teams button. For example, if Number
                            of groups is set to 5, then your list of names will
                            be divided into 5 equal teams.
                        </p>
                        <p>
                            Team members per group refers to the total number of
                            team members that should be on each team when you
                            click the Make teams button. For example, if Team
                            members per group is set to 5, then your list of
                            names will be divided into teams with 5 members per
                            team.
                        </p>
                    </div>
                </article>

                <article class="faq-item">
                    <h3>
                        <button
                            class="faq-question"
                            type="button"
                            aria-expanded="false"
                            aria-controls="faq-answer-4"
                            id="faq-button-4"
                        >
                            <span>How do I add team leaders to each team?</span>
                            <span class="faq-icon" aria-hidden="true">+</span>
                        </button>
                    </h3>
                    <div
                        class="faq-answer"
                        id="faq-answer-4"
                        role="region"
                        aria-labelledby="faq-button-4"
                    >
                        <p>
                            Select the Include team leaders checkbox to add team
                            leaders to each team. The first team member on each
                            team will be designated the leader.
                        </p>
                    </div>
                </article>

                <article class="faq-item">
                    <h3>
                        <button
                            class="faq-question"
                            type="button"
                            aria-expanded="false"
                            aria-controls="faq-answer-5"
                            id="faq-button-5"
                        >
                            <span>How do I change team leaders?</span>
                            <span class="faq-icon" aria-hidden="true">+</span>
                        </button>
                    </h3>
                    <div
                        class="faq-answer"
                        id="faq-answer-5"
                        role="region"
                        aria-labelledby="faq-button-5"
                    >
                        <p>
                            You can change who is the designated team leader on
                            each by dragging a player onto the team leader slot
                            on the team on which they should be the leader.
                        </p>
                    </div>
                </article>

                <article class="faq-item">
                    <h3>
                        <button
                            class="faq-question"
                            type="button"
                            aria-expanded="false"
                            aria-controls="faq-answer-6"
                            id="faq-button-6"
                        >
                            <span
                                >How do I add multiple team leaders per team?</span
                            >
                            <span class="faq-icon" aria-hidden="true">+</span>
                        </button>
                    </h3>
                    <div
                        class="faq-answer"
                        id="faq-answer-6"
                        role="region"
                        aria-labelledby="faq-button-6"
                    >
                        <p>
                            Select the Use separate leader list to add multiple
                            team leaders on each team. The names entered on this
                            list will be evenly divided among the teams. Use
                            drag and drop to move team leaders between teams.
                        </p>
                    </div>
                </article>
                <article class="faq-item">
                    <h3>
                        <button
                            class="faq-question"
                            type="button"
                            aria-expanded="false"
                            aria-controls="faq-answer-6"
                            id="faq-button-6"
                        >
                            <span
                                >How many teams can I create? How many people
                                can be on each team?</span
                            >
                            <span class="faq-icon" aria-hidden="true">+</span>
                        </button>
                    </h3>
                    <div
                        class="faq-answer"
                        id="faq-answer-6"
                        role="region"
                        aria-labelledby="faq-button-6"
                    >
                        <p>
                            There is no limit to the number of teams you can
                            create or the number of team members that can be on
                            each team.
                        </p>
                    </div>
                </article>
                <article class="faq-item">
                    <h3>
                        <button
                            class="faq-question"
                            type="button"
                            aria-expanded="false"
                            aria-controls="faq-answer-6"
                            id="faq-button-6"
                        >
                            <span>How do I save my teams?</span>
                            <span class="faq-icon" aria-hidden="true">+</span>
                        </button>
                    </h3>
                    <div
                        class="faq-answer"
                        id="faq-answer-6"
                        role="region"
                        aria-labelledby="faq-button-6"
                    >
                        <p>
                            You can click the Print button to print your team
                            list or save it as a PDF. Then you can distribute or
                            make copies of the list as needed.
                        </p>
                    </div>
                </article>
                <article class="faq-item">
                    <h3>
                        <button
                            class="faq-question"
                            type="button"
                            aria-expanded="false"
                            aria-controls="faq-answer-6"
                            id="faq-button-6"
                        >
                            <span>Is my data secure?</span>
                            <span class="faq-icon" aria-hidden="true">+</span>
                        </button>
                    </h3>
                    <div
                        class="faq-answer"
                        id="faq-answer-6"
                        role="region"
                        aria-labelledby="faq-button-6"
                    >
                        <p>
                            Teach Tools does not store any of your information.
                            None of the information that you enter into the
                            Random Team Generator will be stored any longer than
                            is needed to generate the list of teams.
                        </p>
                    </div>
                </article>
            </div>
        </section>
    </div>

    <script src="../scripts/team-generator.js"></script>
</PageLayout>

---
import PageLayout from "../layouts/PageLayout.astro";
import { DEFAULT_NAMES } from "../constants/default-names.js";
import HowToSection from "../components/content/HowToSection.astro";
import FeaturesSection from "../components/content/FeaturesSection.astro";
import WhenToUseSection from "../components/content/WhenToUseSection.astro";
import FaqSection from "../components/content/FaqSection.astro";
import { randomNamePickerContent } from "../data/random-name-picker-content.js";
import "../styles/random-picker.css";

const defaultNamesText = DEFAULT_NAMES.join("\n");
---

<PageLayout
    title="Random Name Picker - TeachTools"
    description="Pick names at random in seconds with optional no-repeat fairness mode so every participant gets a turn before repeats. Make sure every name gets called on equally. Great for class participation, presentations, school activities, and games. All tools on TeachTools are free to use, no payment or login required."
>
    <h1>Random Name Picker</h1>
    <div class="app random-picker-app">
        <div class="panel">
            <div class="names-section">
                <div class="clear-container">
                    <label for="names" id="namesLabel">Names</label>
                    <button
                        type="button"
                        class="btn-tertiary btn-small hidden"
                        id="clear">Clear</button
                    >
                </div>
                <textarea id="names">{defaultNamesText}</textarea>
            </div>

            <div class="controls">
                <div class="checkbox-container">
                    <label for="includeLeaders">
                        <input type="checkbox" id="includeLeaders" />
                        <span
                            >Pick equally<p
                                style="margin: 0.5rem 0 0; color: #666; font-size: 0.75rem;"
                            >
                                No repeats until everyone is picked
                            </p></span
                        >
                    </label>
                </div>

                <button type="button" class="btn-primary" id="generateTeamsBtn">
                    Pick Next
                </button>
                <span class="help-text" id="pick-next-help"
                    >Press <kbd>Space</kbd> or <kbd>Enter</kbd> to pick again</span
                >
            </div>
        </div>

        <div id="pickerResult" class="panel hidden" role="main"></div>
    </div>
    <div class="page-content">
        <HowToSection
            headingId={randomNamePickerContent.howTo.headingId}
            title={randomNamePickerContent.howTo.title}
            intro={randomNamePickerContent.howTo.intro}
            items={randomNamePickerContent.howTo.items}
        />
        <FeaturesSection
            headingId={randomNamePickerContent.features.headingId}
            title={randomNamePickerContent.features.title}
            intro={randomNamePickerContent.features.intro}
            items={randomNamePickerContent.features.items}
        />
        <WhenToUseSection
            headingId={randomNamePickerContent.whenToUse.headingId}
            title={randomNamePickerContent.whenToUse.title}
            intro={randomNamePickerContent.whenToUse.intro}
            items={randomNamePickerContent.whenToUse.items}
        />
        <FaqSection
            headingId={randomNamePickerContent.faq.headingId}
            title={randomNamePickerContent.faq.title}
            intro={randomNamePickerContent.faq.intro}
            items={randomNamePickerContent.faq.items}
        />
    </div>
    <script src="../scripts/random-picker.js"></script>
</PageLayout>
